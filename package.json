{
  "name": "LifeLink",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "start": "react-native start",
    "test": "jest",
    "clean": "cd android && ./gradlew clean && cd ..",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "build": "cd android && ./gradlew build && cd ..",
    "debug": "cd android && ./gradlew assembleDebug && cd ..",
    "release": "cd android && ./gradlew assembleRelease && cd ..",
    "release:fast": "cd android && ./gradlew assembleRelease -x lint -x lintVitalRelease -x test && cd ..",
    "bundle:release": "cd android && ./gradlew bundleRelease -x lint -x lintVitalRelease && cd ..",
    "android:fast": "npx react-native run-android --active-arch-only",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "sentry:remove": "powershell -Command \"Remove-Item Env:SENTRY_AUTH_TOKEN -ErrorAction SilentlyContinue\"",
    "sentry:set": "powershell -Command \"$Env:SENTRY_AUTH_TOKEN='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'; setx SENTRY_AUTH_TOKEN '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'\"",
    "sentry:refresh": "npm run sentry:remove && npm run sentry:set"
  },
