{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "esModuleInterop": true,
    "baseUrl": "./src",
     "paths": {
      "@assets/*": ["assets/*"],
      "@theme/*": ["shared/theme/*"],
      "@components/*": ["shared/components/*"],
      "@hooks/*": ["shared/hooks/*"],
      "@utils/*": ["shared/utils/*"],
      "@screens/*": ["screens/*"],
      "@services/*": ["shared/services/*"],
      "@config/*": ["shared/config/*"],
      "@shared/*": ["shared/*"],
      "@navigation/*": ["navigation/*"],
      "@store/*": ["store/*"],
      "@providers/*": ["shared/providers/*"],
      "@api/*": ["shared/api/*"],
      "@query/*": ["shared/query/*"]
    },
  },
  "include": ["**/*.ts", "**/*.tsx", "index.js"],
  "exclude": ["**/node_modules", "**/Pods", "dashboard"]
}
